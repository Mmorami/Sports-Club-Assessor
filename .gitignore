# ============================================================
# Championship Squad Tracker — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pytype/

# Linting
.ruff_cache/

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# ----- IDE & Editors -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Secrets & Environment -----
.env
.env.local
.env.*.local
*.pem
*.key

# ----- Generated Data -----
# Raw and processed data output (regenerated by the pipeline)
data/raw/*
data/processed/*
output/

# Keep the data directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# ----- Miscellaneous -----
*.log
*.bak
*.tmp
